# Production environment template for SEALED.
# Copy to `.env` (git-ignored) or set these as real environment variables in
# your host.  NEVER commit real secrets.

# ── Core ────────────────────────────────────────────────────────────
# Debug must be false in production. Leaving it true disables HTTPS redirects
# and can expose secrets/errors.
DJANGO_DEBUG=false
# Strong random value; generating one with Python: secrets.token_urlsafe(64)
DJANGO_SECRET_KEY=
# Comma-separated hostnames the site answers on, e.g. your-app.com
DJANGO_ALLOWED_HOSTS=
# Public base URL for absolute links in emails, e.g. https://your-app.com
DJANGO_SITE_URL=

# ── Email / SMTP (login OTP + welcome + password reset) ────────────
# Gmail example (enable 2FA on the sender account, create an "App password"):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
# Seconds to wait on SMTP before giving up (defaults to 15).
EMAIL_TIMEOUT=15

# ── Firebase ───────────────────────────────────────────────────────
# Place firebase_credentials.json (service account) next to this file.
# For local emulator-only development, set:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080